ARG REGISTRY_URL=docker.centreon.com/centreon

FROM ${REGISTRY_URL}/debian:bookworm

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=en_US.utf8

# Base system: locale, tools
RUN bash -e <<EOF
apt-get update
apt-get install -y locales wget gnupg2 curl jq ca-certificates software-properties-common zstd procps
localedef -i en_US -c -f UTF-8 -A /usr/share/locale/locale.alias en_US.UTF-8
apt-get clean
rm -rf /var/lib/apt/lists/*
EOF

# Robot Framework
RUN bash -e <<EOF
apt-get update
apt-get install -y python3-dev python3-pip
rm -rf /usr/lib/python3.11/EXTERNALLY-MANAGED
pip3 install robotframework
apt-get clean
rm -rf /var/lib/apt/lists/*
EOF

# Centreon packages (stream connectors lib + broker)
# NOTE: in CI, pass --build-arg CENTREON_REPO=https://packages.centreon.com/apt-standard/
# to install official packages.
# Without this arg the layer is a no-op: sc_runner.lua loads modules from the repo
# checkout and broker globals are provided by broker_mock.lua.
ARG CENTREON_REPO=""
RUN test -z "$CENTREON_REPO" || ( \
    wget -qO- https://apt-key.centreon.com | gpg --dearmor > /etc/apt/trusted.gpg.d/centreon.gpg && \
    echo "deb $CENTREON_REPO bookworm-25.10-stable main" > /etc/apt/sources.list.d/centreon.list && \
    apt-get update && \
    apt-get install -y centreon-broker centreon-stream-connectors-lib && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* \
)

# Lua runtime and libraries for the Robot Framework test runner
RUN bash -e <<EOF
apt-get update
apt-get install -y lua5.3 lua-cjson lua-socket
apt-get clean
rm -rf /var/lib/apt/lists/*
EOF
